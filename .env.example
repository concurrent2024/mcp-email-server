# ---------------------------------------------------------------------------
# IMAP (receiving)
# ---------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
# For Gmail / QQ / 163 this is an app password ("授权码"), not your login password.
IMAP_PASSWORD=your-app-password
# ssl (implicit TLS, port 993) | starttls (port 143) | plain (never use over the internet)
IMAP_SECURITY=ssl

# ---------------------------------------------------------------------------
# SMTP (sending). Host is required; credentials fall back to the IMAP ones.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your-app-password
# ssl (implicit TLS, port 465) | starttls (port 587) | plain
SMTP_SECURITY=ssl

# Envelope sender. Defaults to SMTP_USERNAME / IMAP_USERNAME when omitted.
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Your Name

# ---------------------------------------------------------------------------
# Safety switches. Defaults are deliberately conservative: out of the box the
# server can only read mail.
# ---------------------------------------------------------------------------

# Sending is refused until you opt in.
EMAIL_ALLOW_SEND=false

# Comma-separated allowlist of recipients. Entries are either a full address
# ("teammate@example.com") or a domain ("@example.com" / "example.com").
# Empty means "any recipient is allowed" -- while testing, put your own address
# here so a confused model cannot mail strangers.
EMAIL_RECIPIENT_ALLOWLIST=

# Deleting and moving messages is refused until you opt in.
EMAIL_ALLOW_DELETE=false

# Append a copy of every sent message to the Sent folder over IMAP. Gmail does
# this server-side already; QQ, 163 and most others do not, so turn this on
# there or your sent mail will exist nowhere but the recipient's inbox.
EMAIL_SAVE_SENT_COPY=false

# Attachments may only be read from / written to this directory.
EMAIL_ATTACHMENT_DIR=./attachments

# Upper bound on how much body text read_email may return, so a single huge
# message cannot blow up the model's context window.
EMAIL_MAX_BODY_CHARS=20000

# Folder that save_draft appends to, and the folder delete_email moves to.
# Leave unset to let the server auto-detect them from the IMAP server.
# EMAIL_DRAFTS_FOLDER=Drafts
# EMAIL_TRASH_FOLDER=Trash

# Socket timeout in seconds for both IMAP and SMTP.
# NETWORK_TIMEOUT=30
